{
  "name": "rollup-plugin-htaccess",
  "version": "0.13.2",
  "description": "A rolldown/rollup/vite plugin to generate .htaccess files",
  "keywords": [
    "rollup-plugin",
    "htaccess",
    "apache"
  ],
  "homepage": "https://github.com/marekdedic/rollup-plugin-htaccess",
  "bugs": {
    "url": "https://github.com/marekdedic/rollup-plugin-htaccess/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marekdedic/rollup-plugin-htaccess.git"
  },
  "license": "MIT",
  "author": "Marek Dědič",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/rollup-plugin-htaccess.js"
    }
  },
  "module": "dist/rollup-plugin-htaccess.js",
  "types": "dist/rollup-plugin-htaccess.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "rollup -c",
    "check": "FORCE_COLOR=1 run-p -c --aggregate-output check:*",
    "check:js-compat": "es-check es2023 --module --checkFeatures 'dist/**/*.js'",
    "clean": "rimraf dist/*",
    "lint": "FORCE_COLOR=1 run-p -c --aggregate-output lint:*",
    "lint:eslint": "eslint",
    "lint:ts": "FORCE_COLOR=1 run-p -c --aggregate-output lint:ts:*",
    "lint:ts:attw": "attw --pack",
    "lint:ts:typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "start": "rollup -cw",
    "test": "vitest run --coverage",
    "test-watch": "vitest"
  },
  "dependencies": {
    "domutils": "^4.0.2",
    "glob": "^13.0.0",
    "htmlparser2": "^12.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.1",
    "@microsoft/api-extractor": "^7.47.2",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.0.4",
    "@vitest/eslint-plugin": "^1.6.7",
    "es-check": "^9.6.4",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-package-json": "^1.1.0",
    "eslint-plugin-perfectionist": "^5.0.0",
    "eslint-plugin-prefer-arrow-functions": "^3.4.0 <3.11",
    "eslint-plugin-prettier": "^5.1.3",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.1",
    "rolldown": "^1.0.2",
    "rollup": "^4.18.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.4"
  },
  "peerDependencies": {
    "rolldown": "^1.0.0",
    "rollup": "^3.29.4 || ^4.0.0",
    "vite": "^4.5.14 || ^5.4.19 || ^6.3.5 || ^7.3.1 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.0.0 || ^24.0.0 || ^26.0.0",
    "npm": ">=8.0.0"
  }
}
